                n_block: 3                                                                          
                diffusion_transformer_block:                                                        
                  n_head: 4                                                                         
                  no_residual_connection_between_attention_and_transition: true                     
                  kq_norm: true                                                                     
        distogram_head:                                                                             
          bins: 65                                                                                  
        inference_sampler:                                                                          
          solver: af3                                                                               
          num_timesteps: 50                                                                         
          min_t: 0                                                                                  
          max_t: 1                                                                                  
